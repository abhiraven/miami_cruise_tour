# Neon Postgres connection string (pooled). Sign up at https://neon.tech,
# create a project, and copy the connection string from "Connection Details".
DATABASE_URL=

# Random secret used to sign admin session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Vercel Blob store (for admin-uploaded images). Create a Blob store in your
# Vercel project's Storage tab and copy these two values.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Seeds the first admin account when you run `npm run seed`. Leave
# SEED_ADMIN_PASS blank to have the script generate and print a random
# password once instead.
SEED_ADMIN_USER=admin
SEED_ADMIN_PASS=

# Cloudflare Turnstile (bot protection on /admin/login). Create a widget at
# https://dash.cloudflare.com -> Turnstile -> Add Site, then copy its site
# key and secret key below. Leave both unset to skip Turnstile entirely --
# login still works without it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
